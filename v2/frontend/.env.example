# URL of the FastAPI backend on Render (no trailing slash).
# Leave empty in local dev — Vite proxies /api to localhost:8000.
VITE_API_URL=https://your-backend.onrender.com

# Web3Forms public access key (same one v1 used). Locally it falls back to WEB3FORMS_ACCESS_KEY in the repo-root .env.
VITE_WEB3FORMS_KEY=
